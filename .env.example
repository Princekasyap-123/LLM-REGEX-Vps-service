# ---------- Service ----------
SERVICE_API_KEY=change_me_long_random_secret
# LOG_DIR=/opt/ats-structurer/logs
# DB_PATH=/opt/ats-structurer/data/jobs.db
LOG_PAYLOAD=1
# HTTP_TIMEOUT=120                                # save/login/Ollama HTTP timeout (sec)

# ---------- Ollama cloud (3 keys, comma separated) ----------
OLLAMA_API_KEYS=key1,key2,key3
OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_URL=https://ollama.com/api/chat
KEY_MIN_INTERVAL=5
KEY_SESSION_BUDGET=0
RATE_LIMIT_COOLDOWN=900
# WAIT_FOR_KEY_SECONDS=60     # saari keys busy hon to kitni der wait kare
# SCHEMA_IN_PROMPT=1

# ---------- Duplicate check (White Force, public API - no auth) ----------
# POST {"phone","email"} -> {"exists": bool, "matched_by": ...}. Khaali = sirf local cache se check
DUPLICATE_CHECK_API_URL=https://white-force.com/plus/api/check-candidate-exists
DUPLICATE_CHECK_TIMEOUT=8
CHECK_FAIL_OPEN=0
REQUIRE_PHONE=0

# ---------- Database API (candidate save, public - no login) ----------
SENIORS_URL=https://white-force.com/plus/api/store-candidate-data-from-chrome-extention
SAVE_CREATED_BY=1
SENIORS_LOGIN_URL=
SENIORS_USER=
SENIORS_PASS=
SENIORS_USER_FIELD=email
SENIORS_PASS_FIELD=password
SENIORS_TOKEN_PATH=token
# SENIORS_TOKEN=                                      # sirf agar login API nahi hai
SENIORS_AUTH_HEADER=Authorization
SENIORS_AUTH_PREFIX="Bearer "

# ---------- Tuning ----------
WORKERS=4
MAX_ATTEMPTS=4
MIN_TEXT_LEN=200
RETENTION_DAYS=7
SEEN_TTL_DAYS=30
