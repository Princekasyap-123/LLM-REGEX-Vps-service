# ---------- Service ----------
SERVICE_API_KEY=change_me_long_random_secret      # openssl rand -hex 32
# LOG_DIR=/opt/ats-structurer/logs
# DB_PATH=/opt/ats-structurer/data/jobs.db
LOG_PAYLOAD=1                                     # 1 = save API ka poora payload + response logs mein dikhao
# HTTP_TIMEOUT=120                                # save/login/Ollama HTTP timeout (sec)

# ---------- Ollama cloud (3 keys, comma separated) ----------
OLLAMA_API_KEYS=key1,key2,key3
OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_URL=https://ollama.com/api/chat
KEY_MIN_INTERVAL=5            # ek key ke 2 calls ke beech gap (sec)
KEY_SESSION_BUDGET=0          # 0 = off; pehli raat ke baad /stats dekh ke set karo
RATE_LIMIT_COOLDOWN=900       # 429 ke baad key kitni der rest kare (sec)
# WAIT_FOR_KEY_SECONDS=60     # saari keys busy hon to kitni der wait kare
# SCHEMA_IN_PROMPT=1

# ---------- Duplicate check (White Force, public API - no auth) ----------
# POST {"phone","email"} -> {"exists": bool, "matched_by": ...}. Khaali = sirf local cache se check
DUPLICATE_CHECK_API_URL=https://white-force.com/plus/api/check-candidate-exists
DUPLICATE_CHECK_TIMEOUT=8                                # sec
CHECK_FAIL_OPEN=0                                        # 0 = check API down ho to job rukegi (duplicate nahi banega)
REQUIRE_PHONE=0                                          # 1 = phone na mile to reject

# ---------- Database API (candidate save, public - no login) ----------
SENIORS_URL=https://white-force.com/plus/api/store-candidate-data-from-chrome-extention
SAVE_CREATED_BY=1                                     # payload ka createdBy, hamesha 1
SENIORS_LOGIN_URL=                                    # save API public hai: khaali rakho (login sirf tab jab auth lage)
SENIORS_USER=
SENIORS_PASS=
SENIORS_USER_FIELD=email
SENIORS_PASS_FIELD=password
SENIORS_TOKEN_PATH=token                              # login response mein token ki jagah, e.g. data.accessToken
# SENIORS_TOKEN=                                      # sirf agar login API nahi hai
SENIORS_AUTH_HEADER=Authorization
SENIORS_AUTH_PREFIX="Bearer "

# ---------- Tuning ----------
WORKERS=4
MAX_ATTEMPTS=4
MIN_TEXT_LEN=200
RETENTION_DAYS=7
SEEN_TTL_DAYS=30
